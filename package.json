{
  "name": "mastercommit",
  "displayName": "mastercommit",
  "description": "an awesome commit generator based on IA",
  "publisher": "eigrom",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:mastercommit.generateCommit",
    "onView:mastercommit.settingsView"
  ],
  "main": "./dist/extension.js",
  "icon": "images/preview.png",
  "contributes": {
    "commands": [
      {
        "command": "mastercommit.generateCommit",
        "title": "Generate Commit Message",
        "icon": "$(star)",
        "category": "MasterCommit"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mastercommit-settings",
          "title": "MasterCommit",
          "icon": "images/settings-icon.svg"
        }
      ]
    },
    "views": {
      "mastercommit-settings": [
        {
          "type": "webview",
          "id": "mastercommit.settingsView",
          "name": "Configuración"
        }
      ]
    },
    "menus": {
      "scm/title": [
        {
          "command": "mastercommit.generateCommit",
          "when": "scmProvider == git",
          "enablement": "mastercommit.hasStagedFiles",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MasterCommit",
      "properties": {
        "mastercommit.provider": {
          "type": "string",
          "enum": ["openrouter", "openai", "anthropic"],
          "enumDescriptions": [
            "OpenRouter (OpenAI-compatible, multi-model gateway)",
            "Native OpenAI API (ChatGPT)",
            "Anthropic Claude API"
          ],
          "default": "openrouter",
          "description": "AI provider used for commit message generation"
        },
        "mastercommit.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL override for the selected provider. Leave empty to use the provider's default endpoint."
        },
        "mastercommit.model": {
          "type": "string",
          "default": "",
          "description": "Model identifier to use for commit generation (e.g., openai/gpt-4o, gpt-4o, claude-sonnet-4-5-20250929)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
