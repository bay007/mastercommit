{
  "name": "mastercommit",
  "displayName": "mastercommit",
  "description": "an awesome commit generator based on IA",
  "publisher": "eigrom",
  "version": "1.3.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:mastercommit.generateCommit",
    "onView:mastercommit.settingsView"
  ],
  "main": "./dist/extension.js",
  "icon": "images/preview.png",
  "contributes": {
    "commands": [
      {
        "command": "mastercommit.generateCommit",
        "title": "Generate Commit Message",
        "icon": "$(star)",
        "category": "MasterCommit"
      },
      {
        "command": "mastercommit.showLastRequest",
        "title": "Show Last Request",
        "category": "MasterCommit"
      },
      {
        "command": "mastercommit.verifyProviderEndpoint",
        "title": "Verify Provider Endpoint",
        "category": "MasterCommit"
      },
      {
        "command": "mastercommit.previewRequest",
        "title": "Preview Request (Dry Run)",
        "category": "MasterCommit"
      },
      {
        "command": "mastercommit.switchProfile",
        "title": "Switch Profile",
        "category": "MasterCommit"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mastercommit-settings",
          "title": "MasterCommit",
          "icon": "images/settings-icon.svg"
        }
      ]
    },
    "views": {
      "mastercommit-settings": [
        {
          "type": "webview",
          "id": "mastercommit.settingsView",
          "name": "Configuración"
        }
      ]
    },
    "menus": {
      "scm/title": [
        {
          "command": "mastercommit.generateCommit",
          "when": "scmProvider == git",
          "enablement": "mastercommit.hasStagedFiles",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MasterCommit",
      "properties": {
        "mastercommit.provider": {
          "type": "string",
          "enum": [
            "openrouter",
            "openai",
            "anthropic"
          ],
          "enumDescriptions": [
            "OpenRouter (OpenAI-compatible, multi-model gateway)",
            "Native OpenAI API (ChatGPT)",
            "Anthropic Claude API"
          ],
          "default": "openrouter",
          "description": "AI provider used for commit message generation"
        },
        "mastercommit.providerSettings": {
          "type": "object",
          "default": {},
          "description": "Per-provider base URL and model, keyed by provider id (openrouter/openai/anthropic). Leave a provider's baseUrl empty to use its default endpoint.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "upstreamProvider": {
                "type": "string",
                "description": "OpenRouter only: forces a specific upstream provider (sent as provider.order)."
              }
            }
          }
        },
        "mastercommit.auditLog.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Write a local JSONL audit trail to .mastercommit/audit.log for every generation request (provider, host, model, diff hash — never diff content)."
        },
        "mastercommit.maxDiffTokens": {
          "type": "number",
          "default": 12000,
          "description": "Warn before sending a staged diff estimated above this token count. Set to 0 to disable the check."
        },
        "mastercommit.fallbackProvider": {
          "type": "string",
          "enum": ["", "openrouter", "openai", "anthropic"],
          "default": "",
          "description": "Optional provider to retry with if the primary provider fails or times out. Leave empty to disable."
        },
        "mastercommit.profiles": {
          "type": "array",
          "default": [],
          "description": "Named provider profiles switchable via the \"MasterCommit: Switch Profile\" command.",
          "items": {
            "type": "object",
            "required": ["id", "label", "provider"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "provider": {
                "type": "string",
                "enum": ["openrouter", "openai", "anthropic"]
              },
              "baseUrl": { "type": "string" },
              "model": { "type": "string" },
              "upstreamProvider": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}